# =====================================================================
# Mawared backend — example environment file. Copy to .env, then fill in.
# Never commit real secrets. Production values live in Railway / AWS SSM.
# =====================================================================

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://mawared:mawared@localhost:5432/mawared?schema=public
DIRECT_DATABASE_URL=postgresql://mawared:mawared@localhost:5432/mawared?schema=public
SHADOW_DATABASE_URL=postgresql://mawared:mawared@localhost:5432/mawared_shadow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://api.mawared.local
JWT_AUDIENCE_CUSTOMER=mawared-customer
JWT_AUDIENCE_ADMIN=mawared-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Twilio (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mawared-dev-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Firebase Cloud Messaging (push)
FCM_SERVICE_ACCOUNT_JSON=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=no-reply@mawared.local

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS allowlist for admin + website
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Feature flags
FEATURE_FLAGS_DEFAULT_ENABLED=false
AUTO_REVIEW_ORDERS=true
