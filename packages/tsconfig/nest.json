{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Mawared NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": "./src"
  }
}
